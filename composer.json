{
    "name": "contenir/contenir-brand",
    "description": "Contenir brand head tags — favicon set + theme/brand colours",
    "license": "BSD-3-Clause",
    "type": "library",
    "keywords": [
        "contenir",
        "laminas",
        "mvc",
        "favicon",
        "brand"
    ],
    "homepage": "https://contenir.com.au",
    "support": {
        "issues": "https://contenir.com.au/issues",
        "source": "https://github.com/contenir/contenir-brand"
    },
    "require": {
        "php": "~8.3.0 || ~8.4.0 || ~8.5.0",
        "laminas/laminas-servicemanager": "^3.22",
        "laminas/laminas-view": "^2.35"
    },
    "require-dev": {
        "infection/infection": "^0.34.1",
        "php-db/phpdb-qa-tools": "0.1.x-dev",
        "phpunit/phpunit": "^11.5.42"
    },
    "minimum-stability": "dev",
    "prefer-stable": true,
    "autoload": {
        "psr-4": {
            "Contenir\\Brand\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Contenir\\Brand\\Test\\": "tests/"
        }
    },
    "config": {
        "platform": {
            "php": "8.3.99"
        },
        "sort-packages": true,
        "allow-plugins": {
            "infection/extension-installer": true
        }
    },
    "extra": {
        "branch-alias": {
            "dev-main": "2.0.x-dev"
        },
        "laminas": {
            "component": "Contenir\\Brand"
        }
    },
    "scripts": {
        "check": [
            "@cs-check",
            "@static-analysis",
            "@test",
            "@test-integration",
            "@mutation-test"
        ],
        "cs-check": [
            "mago format --check",
            "mago lint"
        ],
        "cs-fix": [
            "mago format",
            "mago lint --fix"
        ],
        "static-analysis": "mago analyze",
        "test": "phpunit --colors=always --testsuite unit",
        "test-integration": "phpunit --colors=always --testsuite integration",
        "test-coverage": "phpunit --colors=always --coverage-clover clover.xml",
        "mutation-test": "infection"
    }
}
