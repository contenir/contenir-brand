{
    "name": "contenir/contenir-brand",
    "description": "Contenir brand head tags — favicon set + theme/brand colours",
    "license": "BSD-3-Clause",
    "keywords": [
        "contenir",
        "laminas",
        "mvc",
        "favicon",
        "brand"
    ],
    "homepage": "https://contenir.com.au",
    "support": {
        "issues": "https://contenir.com.au/issues",
        "source": "https://github.com/contenir/contenir-brand"
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "dealerdirect/phpcodesniffer-composer-installer": true
        }
    },
    "extra": {
        "laminas": {
            "component": "Contenir\\Brand"
        }
    },
    "require": {
        "php": "^8.1",
        "laminas/laminas-view": "^2.35"
    },
    "require-dev": {
        "laminas/laminas-coding-standard": "^3.0",
        "phpunit/phpunit": "^10.5"
    },
    "autoload": {
        "psr-4": {
            "Contenir\\Brand\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Contenir\\Brand\\Test\\": "test/"
        }
    },
    "scripts": {
        "cs-check": "phpcs",
        "cs-fix": "phpcbf",
        "test": "phpunit --colors=always"
    }
}
